# Актуальный файл для продакшена: public/.htaccess
# Он копируется в dist при сборке. Этот файл оставлен для совместимости.
RewriteEngine On
RewriteBase /

RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

RewriteCond %{HTTP_HOST} ^www\.ringoostroy\.ru$ [NC]
RewriteRule ^(.*)$ https://ringoostroy.ru/$1 [L,R=301]

RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

RewriteRule ^ index.html [L]
